# Copy thanh .env.local (local) hoac khai bao trong Vercel > Settings > Environment Variables.
# Dia chi backend mac dinh khi mo web-app (nguoi dung van doi duoc trong app, luu localStorage).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Token mac dinh (khop API_TOKEN cua backend). De trong neu backend khong bat token.
NEXT_PUBLIC_BACKEND_TOKEN=
